<?xml version="1.0" encoding="UTF-8" ?>
<component>
    <jsfComponent>
        <library>cms/components/frontend/component</library>
        <name>recordshowcase</name>
    </jsfComponent>
    <label>cms_component__record_showcase__label</label>
    <description>cms_component__record_showcase__desc</description>
    <type>image</type>
    <content>
        <item id="heading">
            <label>cms_component__record_showcase__heading</label>
            <className>io.goobi.viewer.model.cms.pages.content.types.CMSShortTextContent</className>
            <jsfComponent>
                <library>cms/components/backend/content</library>
                <name>text</name>
            </jsfComponent>
        </item>
        <item id="subline">
            <label>cms_component__record_showcase__subline</label>
            <className>io.goobi.viewer.model.cms.pages.content.types.CMSShortTextContent</className>
            <jsfComponent>
                <library>cms/components/backend/content</library>
                <name>text</name>
            </jsfComponent>
        </item>
        <item id="slider">
            <label>cms_component__record_showcase__slider</label>
            <className>io.goobi.viewer.model.cms.pages.content.types.CMSSliderContent</className>
            <jsfComponent>
                <library>cms/components/backend/content</library>
                <name>slider</name>
            </jsfComponent>
        </item>
    </content>

    <attribute
        name="hideOnScreenSizes"
        type="toggle">
        <value label="Hide on desktop">hideDesktop</value>
        <value label="Hide on mobile">hideMobile</value>
    </attribute>
</component>
