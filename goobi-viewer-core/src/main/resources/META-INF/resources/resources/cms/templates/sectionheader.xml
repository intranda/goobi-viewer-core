<?xml version="1.0" encoding="UTF-8" ?>
<component>
    <jsfComponent>
        <library>cms/components/frontend/component</library>
        <name>sectionheader</name>
    </jsfComponent>
    <label>cms_component__section_header__label</label>
    <description>cms_component__section_header__desc</description>
    <type>layout</type>

    <content>
        <item id="heading">
            <label>cms_component__section_header__heading</label>
            <className>io.goobi.viewer.model.cms.pages.content.types.CMSShortTextContent</className>
            <jsfComponent>
                <library>cms/components/backend/content</library>
                <name>text</name>
            </jsfComponent>
        </item>
        <item id="icon">
            <label>cms_component__section_header__icon</label>
            <className>io.goobi.viewer.model.cms.pages.content.types.CMSShortTextContent</className>
            <jsfComponent>
                <library>cms/components/backend/content</library>
                <name>text</name>
            </jsfComponent>
        </item>
    </content>

    <attribute
        name="hideOnScreenSizes"
        type="toggle">
        <value label="Hide on desktop">hideDesktop</value>
        <value label="Hide on mobile">hideMobile</value>
    </attribute>
</component>
