<?xml version="1.0" encoding="UTF-8"?>
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">

    <!-- CVE-2006-0197 is an X.Org vulnerability from 2006, incorrectly matched against jbibtex (a Java BibTeX parser) -->
    <suppress>
        <notes><![CDATA[
        file name: jbibtex-1.0.20.jar
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.jbibtex/jbibtex@.*$</packageUrl>
        <cve>CVE-2006-0197</cve>
    </suppress>

    <!-- CVE-2026-23907 and CVE-2026-33929 only affect the ExtractEmbeddedFiles example program, not the PDFBox library itself -->
    <suppress>
        <notes><![CDATA[
        file name: pdfbox-3.0.7.jar / pdfbox-io-3.0.7.jar
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.apache\.pdfbox/pdfbox.*@.*$</packageUrl>
        <cve>CVE-2026-23907</cve>
        <cve>CVE-2026-33929</cve>
    </suppress>


    <!-- braces 2.3.2 reaches the tree on two paths: gulp@4 via glob-watcher (a devDependency) and
         riot@3.12.0 via riot-cli, which is declared in dependencies. Both are build tools - riot-cli
         compiles the riot tags - and node_modules is never deployed, so neither path puts the package
         into the artifact. The second path is why an npm audit restricted to production
         dependencies still reports it. -->
    <suppress>
        <notes><![CDATA[
        file name: braces:2.3.2 - build-time only, via gulp@4/glob-watcher and via riot@3.12.0/riot-cli/chokidar
        ]]></notes>
        <packageUrl regex="true">^pkg:npm/braces@.*$</packageUrl>
        <cve>CVE-2024-4068</cve>
    </suppress>

    <!-- micromatch 3.1.10 arrives on the same two build-time paths as braces above: gulp@4 via
         glob-watcher, gulp-cli and matchdep, and riot@3.12.0 via riot-cli/chokidar. Not deployed. -->
    <suppress>
        <notes><![CDATA[
        file name: micromatch:3.1.10 - build-time only, via gulp@4 and via riot@3.12.0/riot-cli/chokidar
        ]]></notes>
        <packageUrl regex="true">^pkg:npm/micromatch@.*$</packageUrl>
        <cve>CVE-2024-4067</cve>
        <vulnerabilityName>GHSA-952p-6rrq-rcjv</vulnerabilityName>
    </suppress>


    <!-- Jetty 10.0.26 (jetty-io, http2-client and related client artifacts) is a transitive dependency of
         solr-solrj, pulled in purely for its HTTP/2 client used to talk to Solr. jetty-server and
         jetty-security are not on the classpath of either module, and neither module contains any direct
         org.eclipse.jetty usage - confirmed via dependency:tree and a source grep. This rules out the
         request-parsing/server-authentication CVEs below regardless of Jetty version:
           - CVE-2026-2332: HTTP/1.1 parser request smuggling - requires a component parsing untrusted
             inbound requests and forwarding them; we only parse Solr's own responses on a
             self-initiated connection.
           - CVE-2026-5795: JASPIAuthenticator ThreadLocal leak - the vulnerable class lives in
             jetty-security, which is absent from both dependency trees.
           - CVE-2026-6790: missing Host-header-vs-authority check - a server-side request validation
             gap; we are the client setting the Host header, not validating it.
           - CVE-2026-10050: Digest authentication server-side component encodes passwords as ISO-8859-1.
             The affected class is org.eclipse.jetty.security.DigestAuthenticator, which ships in
             jetty-security - absent here. Verified by unpacking the two flagged artifacts: neither
             jetty-io-10.0.26.jar nor http2-client-10.0.26.jar contains that class. The NVD names 10.0.31
             as the fixed version, but the highest published 10.0.x on Maven Central is 10.0.26, so there
             is no upgrade path within the 10 line at all.
         CVE-2025-11143 remains suppressed as before because Jetty is transitive of solr-solrj and cannot
         be upgraded independently; re-evaluate all five once Solr ships a version with a fixed Jetty. -->
    <suppress>
        <notes><![CDATA[
        file name: jetty-*.jar / http2-client-10.0.26.jar - client-only usage transitive of solr-solrj, cannot be upgraded independently
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.eclipse\.jetty.*@.*$</packageUrl>
        <cve>CVE-2025-11143</cve>
        <cve>CVE-2026-2332</cve>
        <cve>CVE-2026-5795</cve>
        <cve>CVE-2026-6790</cve>
        <cve>CVE-2026-10050</cve>
    </suppress>

    <!-- CVE-2025-7962 is an SMTP injection in Jakarta Mail affecting angus-mail < 2.0.4. It is matched
         against angus-activation, which is the Jakarta Activation (JAF) implementation and contains no
         SMTP code at all. The actual mail implementation in the tree is org.eclipse.angus:jakarta.mail
         2.0.5 (shading angus-mail 2.0.5), i.e. above the 2.0.4 fix line - the scan reports that artifact
         without any finding. Scoped to angus-activation only so that real angus-mail findings still
         surface.
         Current NVD data no longer produces this mismatch, so the block matches nothing at the moment.
         It is kept because angus-activation is unchanged at 2.0.3 and CPE matching churns: the analysis
         above stays valid and would otherwise have to be redone when the match returns. -->
    <suppress>
        <notes><![CDATA[
        file name: angus-activation-2.0.3.jar - JAF implementation mismatched against the angus_mail CPE, no SMTP code
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.eclipse\.angus/angus\-activation@.*$</packageUrl>
        <cve>CVE-2025-7962</cve>
    </suppress>


    <!-- CVE-2025-48734 is matched against rewrite-config-prettyfaces because its JAR contains an embedded
         pom.xml referencing commons-beanutils 1.9.4 as metadata. The actual commons-beanutils runtime
         dependency is provided by ICS at 1.11.0 (fixed version); this is a scanner false positive.
         The version is pinned in the selector on purpose, so a prettyfaces upgrade surfaces the finding
         again instead of silently inheriting this suppression. -->
    <suppress>
        <notes><![CDATA[
        file name: rewrite-config-prettyfaces-10.0.2.Final.jar - embedded pom.xml references commons-beanutils 1.9.4 as metadata only, not a runtime dependency
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/commons\-beanutils/commons\-beanutils@1\.9\.4$</packageUrl>
        <cve>CVE-2025-48734</cve>
    </suppress>


    <!-- ZooKeeper 3.9.4 is a transitive dependency of solr-solrj-zookeeper and cannot be upgraded
         independently without risking incompatibility with the Solr client. To be re-evaluated when
         Solr ships a version that includes a fixed ZooKeeper release; solr-solrj 9.10.1 is currently the
         newest published 9.x, so there is no such version to move to. The regex covers both the
         zookeeper and zookeeper-jute artifacts (same release train, same transitive origin). -->
    <suppress>
        <notes><![CDATA[
        file name: zookeeper-3.9.4.jar / zookeeper-jute-3.9.4.jar - transitive of solr-solrj-zookeeper, cannot be upgraded independently
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.apache\.zookeeper/zookeeper.*@.*$</packageUrl>
        <cve>CVE-2026-24308</cve>
        <cve>CVE-2026-24281</cve>
    </suppress>

    <!-- CVE-2026-44825 is hardcoded credentials in the "bin/solr auth enable" setup CLI script of the
         Solr server distribution. goobi-viewer only consumes solr-api/solr-solrj as a Java client
         library against an externally run Solr server; it never ships or invokes bin/solr. -->
    <suppress>
        <notes><![CDATA[
        file name: solr-api-9.10.1.jar / solr-solrj-zookeeper-9.10.1.jar - client library only, bin/solr CLI is not part of this project
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.apache\.solr/solr.*@.*$</packageUrl>
        <cve>CVE-2026-44825</cve>
    </suppress>

</suppressions>
